#!/usr/bin/env node

const path = require("node:path")
const {
  DEFAULT_BASE_URL,
  DEFAULT_PROVIDER,
  DEFAULT_MODEL,
  DEFAULT_DIRECTORY,
  DEFAULT_ENV_FILE,
  DEFAULT_SYSTEM,
  authHeader,
  sendPrompt,
} = require("../src/opencode")
const { listen, DEFAULT_GATEWAY_HOST, DEFAULT_GATEWAY_PORT } = require("../src/server")

function usage(exitCode = 0) {
  const stream = exitCode === 0 ? process.stdout : process.stderr
  stream.write(`Usage: ocq [options] <prompt>
       ocq serve [options]

Send one message to the local OpenCode server, or run an OpenAI-compatible gateway.

Prompt options:
  -s, --session <id>       Continue an existing session
  -m, --model <model>      Model ID or provider/model (default: ${DEFAULT_PROVIDER}/${DEFAULT_MODEL})
  -p, --provider <id>      Provider ID (default: ${DEFAULT_PROVIDER})
  -d, --directory <path>   OpenCode directory context (default: ${DEFAULT_DIRECTORY})
  -u, --url <url>          OpenCode server URL (default: ${DEFAULT_BASE_URL})
      --env <path>         Server env file (default: ${DEFAULT_ENV_FILE})
      --system <text>      System prompt override
      --no-system          Do not send a system prompt
      --agent <name>       OpenCode agent name
      --title <title>      Title for newly-created session
      --json               Print JSON { sessionID, messageID, text }

Serve options:
      --host <host>        Gateway bind host (default: ${DEFAULT_GATEWAY_HOST})
      --port <port>        Gateway bind port (default: ${DEFAULT_GATEWAY_PORT})
      --key <key>          Gateway bearer key (default: OCQ_GATEWAY_KEY)
  -m, --model <model>      Default gateway model provider/model
  -d, --directory <path>   OpenCode directory context
  -u, --url <url>          OpenCode server URL
      --env <path>         Server env file

  -h, --help               Show help

Examples:
  ocq "what changed in OpenCode recently?"
  ocq --json "start a quick conversation"
  ocq --session ses_abc123 "follow up"
  ocq serve --host 127.0.0.1 --port 8088
`)
  process.exit(exitCode)
}

function fail(message, detail) {
  process.stderr.write(`ocq: ${message}\n`)
  if (detail) process.stderr.write(`${detail}\n`)
  process.exit(1)
}

function parseModelOption(opts, value) {
  const slash = value.indexOf("/")
  if (slash > 0) {
    opts.providerID = value.slice(0, slash)
    opts.modelID = value.slice(slash + 1)
  } else {
    opts.modelID = value
  }
}

function parsePromptArgs(argv) {
  const opts = {
    baseUrl: process.env.OPENCODE_SERVER_URL || DEFAULT_BASE_URL,
    providerID: process.env.OCQ_PROVIDER || DEFAULT_PROVIDER,
    modelID: process.env.OCQ_MODEL || DEFAULT_MODEL,
    directory: process.env.OCQ_DIRECTORY || DEFAULT_DIRECTORY,
    envFile: process.env.OCQ_ENV_FILE || DEFAULT_ENV_FILE,
    system: process.env.OCQ_SYSTEM || DEFAULT_SYSTEM,
    json: false,
  }
  const prompt = []

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    const next = () => {
      const value = argv[++i]
      if (!value) fail(`missing value for ${arg}`)
      return value
    }

    if (arg === "--") {
      prompt.push(...argv.slice(i + 1))
      break
    } else if (arg === "-h" || arg === "--help") {
      usage(0)
    } else if (arg === "-s" || arg === "--session") {
      opts.sessionID = next()
    } else if (arg === "-m" || arg === "--model") {
      parseModelOption(opts, next())
    } else if (arg === "-p" || arg === "--provider") {
      opts.providerID = next()
    } else if (arg === "-d" || arg === "--directory") {
      opts.directory = path.resolve(next())
    } else if (arg === "-u" || arg === "--url") {
      opts.baseUrl = next().replace(/\/+$/, "")
    } else if (arg === "--env") {
      opts.envFile = path.resolve(next())
    } else if (arg === "--system") {
      opts.system = next()
    } else if (arg === "--no-system") {
      opts.system = undefined
    } else if (arg === "--agent") {
      opts.agent = next()
    } else if (arg === "--title") {
      opts.title = next()
    } else if (arg === "--json") {
      opts.json = true
    } else if (arg.startsWith("-")) {
      fail(`unknown option ${arg}`)
    } else {
      prompt.push(arg)
    }
  }

  opts.prompt = prompt.join(" ").trim()
  if (!opts.prompt) usage(1)
  return opts
}

function parseServeArgs(argv) {
  const opts = {}

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    const next = () => {
      const value = argv[++i]
      if (!value) fail(`missing value for ${arg}`)
      return value
    }

    if (arg === "-h" || arg === "--help") {
      usage(0)
    } else if (arg === "--host") {
      opts.host = next()
    } else if (arg === "--port") {
      opts.port = Number(next())
      if (!Number.isInteger(opts.port) || opts.port <= 0) fail("invalid --port")
    } else if (arg === "--key") {
      opts.gatewayKey = next()
    } else if (arg === "-m" || arg === "--model") {
      opts.defaultModel = next()
      process.env.OCQ_DEFAULT_MODEL = opts.defaultModel
    } else if (arg === "-d" || arg === "--directory") {
      opts.directory = path.resolve(next())
    } else if (arg === "-u" || arg === "--url") {
      opts.baseUrl = next().replace(/\/+$/, "")
    } else if (arg === "--env") {
      opts.envFile = path.resolve(next())
    } else {
      fail(`unknown serve option ${arg}`)
    }
  }

  return opts
}

async function main() {
  const argv = process.argv.slice(2)
  if (argv[0] === "serve") {
    listen(parseServeArgs(argv.slice(1)))
    return
  }

  const opts = parsePromptArgs(argv)
  opts.authorization = authHeader(opts)

  const result = await sendPrompt(opts)
  if (opts.json) {
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`)
  } else {
    process.stdout.write(result.text ? `${result.text}\n` : "")
  }
}

main().catch((error) => fail(error.message, error.detail || error.stack))
